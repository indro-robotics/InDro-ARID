# Ignore all pycache files
**/__pycache__/**

# Ignore ROS build files
**/build/**
**/install/**
**/cc_internals/**
**/log/**

# Ignore setup logs
workspaces/log/

# Ignore camera calibration venv and output (auto-recreated by camera_calibrate.sh)
local_ws/auxiliary/camera_calibration/calib_env/
local_ws/auxiliary/camera_calibration/camera_calibration_auto/calib_env/
local_ws/auxiliary/camera_calibration/camera_calibrations/*/*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_*.yaml
local_ws/auxiliary/camera_calibration/*_calibration.yaml
# run_logs: contents anywhere + the root convenience symlink
**/run_logs/
/run_logs

# Isaac ROS CUDA/nitros cache
isaac_ros-dev/.cache/
