# Ignore all pycache files
**/__pycache__/**

# Ignore ROS build files
**/build/**
**/install/**
**/cc_internals/**
**/log/**

# Ignore setup logs
workspaces/log/

# Ignore camera calibration venvs and ad-hoc outputs (auto-recreated by camera_calibrate.sh)
local_ws/auxiliary/camera_calibration/calib_env/
local_ws/auxiliary/camera_calibration/camera_calibration_auto/calib_env/
local_ws/auxiliary/camera_calibration/*_calibration.yaml
# Ignore timestamped calibration records under the store; the per-camera <name>.yaml stays tracked.
local_ws/auxiliary/camera_calibration/camera_calibrations/*/*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_*.yaml

# run_logs: contents anywhere + the root convenience symlink
**/run_logs/
/run_logs

# Local machine state (auto-detected LiDAR config, etc.; written by scripts/config_lidar.sh)
.lidar/

# Per-drone VSLAM config (serials); reseeded from vslam_config.template.yaml
isaac_ros-dev/src/px4_vslam/config/vslam_config.yaml
