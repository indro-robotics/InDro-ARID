[Unit]
Description=Starts an ISAAC docker container
After=multi-user.target docker.service
Requires=docker.service

[Service]
User=jetson
Type=simple
# Regenerate CDI spec as root before starting the container - Jetson's /dev/nvidia*
# devices can change after reboots/driver updates, causing the cached spec to reference
# devices that no longer exist (e.g. /dev/nvidia-modeset) and breaking container start.
ExecStartPre=+/usr/bin/nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml
ExecStartPre=/bin/bash -c 'until docker info > /dev/null 2>&1; do sleep 1; done'
ExecStart=/bin/bash -c "/home/jetson/workspaces/isaac_ros-dev/container_scripts/start_isaac_docker.sh"
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
