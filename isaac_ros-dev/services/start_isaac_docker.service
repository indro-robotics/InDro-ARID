[Unit]
Description=Starts an ISAAC docker container
# Order after docker only; After=multi-user.target here cycles with WantedBy and drops arid_supervisor's boot job.
After=docker.service
Requires=docker.service
# Pull in the supervisor whenever this service starts (boot + manual systemctl start/restart).
Wants=arid_supervisor.service

[Service]
User=jetson
Type=simple
# Stay active after the container starts, else dependents (arid_supervisor, via Requires/PartOf) are torn down on boot.
RemainAfterExit=yes
# Regenerate CDI spec as root before starting the container - Jetson's /dev/nvidia*
# devices can change after reboots/driver updates, causing the cached spec to reference
# devices that no longer exist (e.g. /dev/nvidia-modeset) and breaking container start.
ExecStartPre=+/usr/bin/nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml
# Bounded poll: 60 s max. Without a bound, the loop runs until systemd's TimeoutStartSec
# kills it (90 s default), producing a confusing "service stuck in activating" state.
# Explicit failure within the bound is easier to diagnose.
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do docker info >/dev/null 2>&1 && exit 0; sleep 1; done; echo "docker daemon did not come up within 60 s" >&2; exit 1'
ExecStart=/bin/bash -c "/home/jetson/workspaces/isaac_ros-dev/container_scripts/start_isaac_docker.sh"
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
