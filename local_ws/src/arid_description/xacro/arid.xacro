<?xml version="1.0"?>
<!-- ARID airframe frame tree. arid_description.service runs display.launch.py, which feeds this
     to robot_state_publisher on the host as latched /robot_description and /tf_static.

     Link names are an unchecked contract with consumers outside this package. cuVSLAM in the
     container resolves base_frame 'base_link', and realsense2_camera roots its optical-frame
     subtree at camera_name + "_link", which the front_realsense_link name here matches.
     A rename breaks the TF chain at cuVSLAM init. -->
<robot name="arid_drone_v1-0" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- The STL is exported in 0.1 mm units: scaled it spans 0.393 x 0.393 x 0.2047 m, which is the
       collision box below. A mesh re-exported in other units leaves that box wrong. -->
  <xacro:property name="mesh_scale"     value="0.0001"/>
  <xacro:property name="propeller_span" value="0.0975"/>
  <xacro:property name="realsense_z"    value="0.092042"/>

  <xacro:macro name="propeller" params="name x y">
    <link name="${name}_propeller_link"/>
    <joint name="base_link_to_${name}_propeller_link" type="fixed">
      <parent link="base_link"/>
      <child  link="${name}_propeller_link"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="realsense" params="name x y yaw">
    <link name="${name}_realsense_link"/>
    <joint name="base_link_to_${name}_realsense_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="${name}_realsense_link"/>
      <origin xyz="${x} ${y} ${realsense_z}" rpy="0 0 ${yaw}"/>
    </joint>
  </xacro:macro>

  <link name="base_footprint"/>
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.023842" rpy="${-pi/2} 0 ${pi/2}"/>
      <geometry>
        <mesh filename="package://arid_description/meshes/arid_model.stl"
              scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
      </geometry>
      <material name="arid_visual_material">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.070192" rpy="0 0 0"/>
      <geometry>
        <box size="0.393 0.393 0.2047"/>
      </geometry>
    </collision>
  </link>
  <joint name="base_link_to_base_footprint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="autopilot"/>
  <joint name="base_link_to_autopilot" type="fixed">
    <parent link="base_link"/>
    <child  link="autopilot"/>
    <origin xyz="0.042524 0 0.100499" rpy="0 0 0"/>
  </joint>

  <xacro:propeller name="front_left"  x="${propeller_span}"  y="${propeller_span}"/>
  <xacro:propeller name="front_right" x="${propeller_span}"  y="${-propeller_span}"/>
  <xacro:propeller name="rear_left"   x="${-propeller_span}" y="${propeller_span}"/>
  <xacro:propeller name="rear_right"  x="${-propeller_span}" y="${-propeller_span}"/>

  <!-- base_link -> front_realsense_link -> optical frame is the rig extrinsic chain cuVSLAM
       resolves; an error in these origins is a systematic extrinsic error cuVSLAM cannot detect. -->
  <xacro:realsense name="front" x="0.09875"  y="0.0175"   yaw="0"/>

  <link name="rslidar_link"/>
  <joint name="base_link_to_rslidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="rslidar_link"/>
    <origin xyz="0.062732 0 0.16457" rpy="0 0.485201 0"/>
  </joint>

  <!-- cam_down image headers carry this frame id, set in gst_camera_manager's pipelines.yaml. -->
  <link name="bottom_visual_link"/>
  <joint name="base_link_to_bottom_visual_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="bottom_visual_link"/>
    <origin xyz="0.025 0.0 0.000842" rpy="0 ${pi} ${pi/2}"/>
  </joint>

  <link name="flow_link"/>
  <joint name="base_link_to_flow_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="flow_link"/>
    <origin xyz="0.0 -0.0115 -0.008518" rpy="${pi} 0 0"/>
  </joint>

  <link name="rangefinder_link"/>
  <joint name="base_link_to_rangefinder_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="rangefinder_link"/>
    <origin xyz="-0.001322 0.00992 -0.011096" rpy="0 ${pi} 0"/>
  </joint>

</robot>
