[Unit]
Description=Host ROS2 USB reset service
Wants=network-online.target
After=network-online.target
After=systemd-user-sessions.service

[Service]
User=jetson
Type=simple
Environment="ROS_DOMAIN_ID=23"
Environment="HOME=/home/jetson"
ExecStart=/bin/bash -c 'source /opt/ros/humble/setup.bash; source /home/jetson/workspaces/local_ws/install/setup.bash; ros2 run reset_ark_usb reset_usb_service'
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target