[Unit]
Description=RC Trigger ROS2 launch
After=network-online.target

[Service]
User=jetson
Group=jetson
WorkingDirectory=/home/jetson
Environment=ROS_DOMAIN_ID=23
ExecStart=/bin/bash -lc 'source /home/jetson/workspaces/local_ws/install/setup.bash && ros2 launch rc_trigger trigger.launch.py'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target

