[Unit]
Description=Host ROS2 UWB module node service
Wants=network-online.target
After=network-online.target
After=systemd-user-sessions.service

[Service]
User=jetson
Type=simple
Environment="ROS_DOMAIN_ID=23"
Environment="HOME=/home/jetson"
ExecStart=/bin/bash -c 'source /opt/ros/<distro>/setup.bash; source /home/jetson/workspaces/local_ws/install/setup.bash; ros2 run uwb_drone uwb_drone_node'
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target